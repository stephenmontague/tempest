# Development Environment Variables
# Copy this to .env.local and adjust as needed

# Auth Dev Bypass - Set to "true" to skip OIDC authentication
# This creates a mock session for UI development/testing
AUTH_DEV_BYPASS=true

# NextAuth Secret (required even in dev bypass mode)
AUTH_SECRET=dev-secret-change-in-production

# Backend CRUD — one unified API app serves all domains (distinct paths)
OMS_URL=http://localhost:8081
IMS_URL=http://localhost:8081
WMS_URL=http://localhost:8081
SMS_URL=http://localhost:8081

# Temporal (the UI is the Temporal client)
# Auth: leave API_KEY/TLS unset for local dev; set TEMPORAL_API_KEY for Temporal
# Cloud API-key auth, or TEMPORAL_TLS_CERT + TEMPORAL_TLS_KEY (PEM) for mTLS.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=tempest
TEMPORAL_UI_BASE_URL=http://localhost:8080
# TEMPORAL_API_KEY=
# TEMPORAL_TLS_CERT=
# TEMPORAL_TLS_KEY=

# OIDC Configuration (not needed when AUTH_DEV_BYPASS=true)
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret

